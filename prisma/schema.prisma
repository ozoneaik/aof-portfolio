generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ประเภทผลงาน: ใช้กับปุ่มกรอง "งานบริษัท / งานส่วนตัว"
enum ProjectCategory {
  work
  personal
}

// ภาษาที่เว็บรองรับ
enum Locale {
  th
  en
  zh
}

// ข้อมูลหลักของโปรเจกต์ (ส่วนที่ไม่ขึ้นกับภาษา)
model Project {
  id         Int             @id @default(autoincrement())
  slug       String          @unique @db.VarChar(100) // ชื่อสำหรับ URL/key เช่น "callcenter-system-pk" (ห้ามซ้ำ)
  category   ProjectCategory
  featured   Boolean         @default(false) // โปรเจกต์เด่น (การ์ดสีเข้ม)
  sortOrder  Int             @default(0) @map("sort_order") // ลำดับการแสดง
  githubUrl  String?         @map("github_url") @db.VarChar(255) // ? = ไม่บังคับ
  websiteUrl String?         @map("website_url") @db.VarChar(255)
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  translations ProjectTranslation[]
  images       ProjectImage[]
  tags         ProjectTag[]

  @@map("projects")
}

// ข้อความของโปรเจกต์แยกตามภาษา (1 โปรเจกต์ = สูงสุด 3 แถว)
model ProjectTranslation {
  id          Int     @id @default(autoincrement())
  projectId   Int     @map("project_id")
  locale      Locale
  title       String  @db.VarChar(200)
  description String  @db.Text // ข้อความสั้นบนการ์ด
  details     String? @db.Text // รายละเอียดยาวใน dialog
  role        String? @db.Text // "หน้าที่ของผม"
  impacts     Json? // ผลลัพธ์ เช่น ["รวม 4 แพลตฟอร์มไว้ในระบบเดียว"]

  // ลบโปรเจกต์แล้ว ข้อความทุกภาษาถูกลบตาม
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, locale]) // 1 โปรเจกต์มีได้ภาษาละ 1 แถว
  @@map("project_translations")
}

// รูปตัวอย่าง (preview) ของโปรเจกต์
model ProjectImage {
  id        Int     @id @default(autoincrement())
  projectId Int     @map("project_id")
  url       String  @db.VarChar(500) // ลิงก์ R2
  caption   Json? // คำอธิบายรูป { "th": "...", "en": "...", "zh": "..." }
  sortOrder Int     @default(0) @map("sort_order") // ลำดับใน gallery
  isCover   Boolean @default(false) @map("is_cover") // รูปหน้าปก

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sortOrder])
  @@map("project_images")
}

// เทคโนโลยี เช่น React, Laravel (ชื่อห้ามซ้ำ)
model Tag {
  id       Int          @id @default(autoincrement())
  name     String       @unique @db.VarChar(50)
  projects ProjectTag[]

  @@map("tags")
}

// ตารางกลางเชื่อม โปรเจกต์ ↔ เทคโนโลยี
model ProjectTag {
  projectId Int @map("project_id")
  tagId     Int @map("tag_id")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([projectId, tagId]) // คู่เดียวกันห้ามซ้ำ
  @@map("project_tags")
}
